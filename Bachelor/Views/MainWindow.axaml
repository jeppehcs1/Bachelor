<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bachelor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Bachelor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Bachelor">

    

    <!-- <TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" VerticalAlignment="Center"/> -->

    <DockPanel>
        <!-- Plot takes up most of the space -->
        <Menu DockPanel.Dock="Top">
                    <MenuItem Header="Views" Background="DarkGray">
                        <MenuItem Header="Home" Command="{Binding ShowHomeCommand}"/>
                        <MenuItem Header="Plot" Command="{Binding ShowPlotCommand}"/>
                        <MenuItem Header="Cube" Command="{Binding ShowCubeCommand}"/>
                        <MenuItem Header="TSP" Command="{Binding ShowTSPCommand}"/>
                        <MenuItem Header="Schedule" Command="{Binding ShowScheduleCommand}" />
                        
                    </MenuItem>
                </Menu>
        <!-- Content Area -->
        <ContentControl Content="{Binding CurrentView}" Margin="10"/>
    </DockPanel>

</Window>
