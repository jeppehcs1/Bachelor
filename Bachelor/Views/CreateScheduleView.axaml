<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Bachelor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Bachelor.Views.CreateScheduleView"
             x:DataType="vm:CreateScheduleViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="15" HorizontalAlignment="Center" Text="Schedule builder"/>
        <Button DockPanel.Dock="Bottom" Command="{Binding NextOnClickCommand}" IsEnabled="{Binding CanProceed}">Next</Button>
        <ScrollViewer>
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                  Margin="24" ColumnSpacing="20" RowSpacing="8">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Search space" FontWeight="Bold" />
                <ListBox Grid.Column="0" Grid.Row="1"
                          ItemsSource="{Binding SearchSpaces}"
                          SelectedItem="{Binding SelectedSearchSpace}"
                          Width="200" />
                
                <TextBlock Grid.Column="2" Grid.Row="0" Text="Algorithm" FontWeight="Bold" />
                <ListBox Grid.Column="2" Grid.Row="1" 
                          ItemsSource="{Binding Algorithms}"
                          SelectedItem="{Binding SelectedAlgorithm}"
                          Width="200" />
                <Button Grid.Column="2" Grid.Row="2"
                        Command="{Binding ConfigureAlgorithmOnClickCommand}"
                        IsEnabled="{Binding SelectedAlgorithm, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Width="200">
                    Configure Algorithm
                </Button>
                
                <TextBlock Grid.Column="4" Grid.Row="0" Text="Problem" FontWeight="Bold" 
                           />
                <ListBox Grid.Column="4" Grid.Row="1" 
                         ItemsSource="{Binding Problems}"
                         SelectedItem="{Binding SelectedProblem}"
                         Width="200" />
                <StackPanel Grid.Column="4" Grid.Row="4"
                            Orientation="Vertical"
                            Spacing="4"
                            IsVisible="{Binding IsTSP}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="BrowseFileOnClick">Select .tsp File</Button>
                        <TextBox Text="{Binding FilePath}" Width="200" Height="40"/>
                    </StackPanel>
                    <TextBlock Text="{Binding FilePathError}" 
                               Foreground="Red"
                               IsVisible="{Binding FilePathError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
                
                <TextBlock Grid.Column="0" Grid.Row="3" Text="Finish Condition" FontWeight="Bold"/>
                <StackPanel Grid.Column="0" Grid.Row="4" Orientation="Vertical" Spacing="4">
                    <ListBox ItemsSource="{Binding FinishConditions}"
                             SelectedItem="{Binding SelectedFinishCondition}"
                             Width="200"/>
                    <StackPanel IsVisible="{Binding IsFuncEvals}" Orientation="Vertical" Spacing="4">
                        <TextBlock Text="Max function evaluations" FontWeight="Bold"/>
                        <TextBox Text="{Binding MaxFuncEvals}" Width="150"/>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsExactFitness}" Orientation="Vertical" Spacing="4">
                        <TextBlock Text="Exact fitness" FontWeight="Bold"/>
                        <TextBox Text="{Binding ExactFitness}" Width="150"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Grid.Row="3" Text="Visualization" FontWeight="Bold"/>
                <ListBox Grid.Column="2" Grid.Row="4"
                          ItemsSource="{Binding Visualizations}"
                          SelectedItem="{Binding SelectedVisualization}"
                          Width="200"/>
                <TextBlock Grid.Column="4" Grid.Row="3" Text="Dimension (default: 500)" FontWeight="Bold" IsVisible="{Binding !IsTSP}"/>
                <TextBox Grid.Column="4" Grid.Row="4" Text="{Binding Dimension}"
                            Height="40" IsVisible="{Binding !IsTSP}"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
    
</UserControl>
