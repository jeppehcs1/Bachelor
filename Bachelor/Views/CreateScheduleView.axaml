<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Bachelor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Bachelor.Views.CreateScheduleView"
             x:DataType="vm:CreateScheduleViewModel">
    <StackPanel>
        <StackPanel>
            <TextBlock Margin="24"
                       HorizontalAlignment="Center"
                       Text="Schedule sovs">
            </TextBlock>
        
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                  Margin="24" ColumnSpacing="20" RowSpacing="8">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Search space" FontWeight="Bold" />
                <ListBox Grid.Column="0" Grid.Row="1"
                          ItemsSource="{Binding SearchSpaces}"
                          SelectedItem="{Binding SelectedSearchSpace}"
                          Width="200" />
                
                <TextBlock Grid.Column="2" Grid.Row="0" Text="Algorithm" FontWeight="Bold" />
                <ListBox Grid.Column="2" Grid.Row="1" 
                          ItemsSource="{Binding Algorithms}"
                          SelectedItem="{Binding SelectedAlgorithm}"
                          Width="200" />
                
                <TextBlock Grid.Column="4" Grid.Row="0" Text="Problem" FontWeight="Bold" 
                           />
                <ListBox Grid.Column="4" Grid.Row="1" 
                         IsVisible="{Binding !IsPermutations}"
                         ItemsSource="{Binding Problems}"
                         SelectedItem="{Binding SelectedProblem}"
                         Width="200" />
                <StackPanel Grid.Column="4" Grid.Row="1" 
                            Orientation="Horizontal" 
                            Spacing="8"
                            IsVisible="{Binding IsPermutations}">
                    <Button Click="BrowseFileOnClick">Select .tsp File</Button>
                    <TextBox Text="{Binding FilePath}" Width="200"
                             Height="40"/>
                </StackPanel>
                
                <TextBlock Grid.Column="0" Grid.Row="3" Text="Finish Condition" FontWeight="Bold"/>
                <ListBox Grid.Column="0" Grid.Row="4"
                          ItemsSource="{Binding FinishConditions}"
                          SelectedItem="{Binding SelectedFinishCondition}"
                          Width="200"/>
                
                <TextBlock Grid.Column="2" Grid.Row="3" Text="Visualization" FontWeight="Bold"/>
                <ListBox Grid.Column="2" Grid.Row="4"
                          ItemsSource="{Binding Visualizations}"
                          SelectedItem="{Binding SelectedVisualization}"
                          Width="200"/>
                <TextBlock Grid.Column="4" Grid.Row="3" Text="Dimension" FontWeight="Bold"/>
                <TextBox Grid.Column="4" Grid.Row="4" Text="{Binding Dimension}"
                            Height="40"/>
            </Grid>
            <Button Command="{Binding NextOnClickCommand}">Next</Button>
            
        </StackPanel>
        
    </StackPanel>
</UserControl>
