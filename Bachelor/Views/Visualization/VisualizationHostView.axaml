<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:visualization="clr-namespace:Bachelor.Views.Visualization"
             xmlns:visualization1="clr-namespace:Bachelor.ViewModels.Visualization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Bachelor.Views.Visualization.VisualizationHostView"
             x:DataType="visualization1:VisualizationHostViewModel">
    <UserControl.DataTemplates>

        <DataTemplate x:DataType="visualization1:TSPViewModel">
            <visualization:TSPView />
        </DataTemplate>

        <DataTemplate x:DataType="visualization1:PlotViewModel">
            <visualization:PlotView />
        </DataTemplate>

        <DataTemplate x:DataType="visualization1:HypercubeViewModel">
            <visualization:HypercubeView />
        </DataTemplate>

    </UserControl.DataTemplates>
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="100,Auto,*,*">
        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Iterations:"/>
            <TextBlock Text="{Binding IterationCounter}"/>
            <TextBlock Text="BSFF:"/>
            <TextBlock Text="{Binding BSFFCounter}"/>
            <TextBlock Text="FuncEvals:"/>
            <TextBlock Text="{Binding FuncEvalCounter}"/>
            <Slider Orientation="Vertical"
                    Minimum="100"
                    Maximum="10000"
                    Value="{Binding UpdateInterval}"
                    TickFrequency="50"
                    IsSnapToTickEnabled="True"
                    Height="150"
                    Margin="0,10,0,0"/>
            <TextBlock Text="Update interval:"/>
            <TextBlock Text="{Binding UpdateInterval}"/>
        </StackPanel>
        <ContentControl Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                        Content="{Binding CurrentVisualization}" />

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            
            <Button Content="Pause" Command="{Binding PauseCommand}"/> 
            <Button Content="Play" Command="{Binding PlayCommand}"/>
        </StackPanel>
        </Grid>
</UserControl>
