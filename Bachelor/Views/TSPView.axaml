<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Bachelor.ViewModels"
             xmlns:avaPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Bachelor.Views.TSPView"
             x:DataType="vm:TSPViewModel">
             
    
    
    
    
    <StackPanel>
        <avaPlot:AvaPlot x:Name="PlotControl" DockPanel.Dock="Bottom" Height="400"/>
        <Button Command="{Binding IterateTSPOnClickCommand}">Iterate</Button>
    
    </StackPanel>    
</UserControl>

